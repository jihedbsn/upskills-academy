# Laravel Storage
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# Public Uploads (Keep directory structure but ignore files)
/public/uploads/**/*
!/public/uploads/.gitkeep

# Public user-generated content
/public/images/**/*
!/public/images/.gitkeep
/public/login_images/**/*
!/public/login_images/.gitkeep
/public/logo_footers/**/*
!/public/logo_footers/.gitkeep
/public/youtube/**/*
!/public/youtube/.gitkeep

# Storage App Public
/storage/app/public/**/*
!/storage/app/public/.gitkeep

# User uploaded files
/public/storage/

# Ignore Excel/CSV import files
*.xlsx
*.xls
*.csv
!exemple_import_etudiants.csv
!test_import.csv
!test_students.csv

