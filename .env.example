# Root-level settings for the helper scripts (run.sh, deploy-*.sh).
# Copy to .env and fill in real values — .env is gitignored and must never be committed.
# Each Laravel app has its own front/.env and admin-panel/.env (see their .env.example).

# ── Local MySQL container (run.sh) ─────────────────────────
MYSQL_CONTAINER=sast-mysql
MYSQL_ROOT_PASSWORD=change-me
DB_DATABASE=sast
DB_USERNAME=sast
DB_PASSWORD=change-me
# SQL dump imported on first run (not in git — ask the maintainer for it)
DB_DUMP=sast_database.sql

# ── VPS deploy (deploy-front.sh / deploy-admin.sh) ─────────
VPS_HOST=your.server.ip
VPS_USER=ubuntu
VPS_SSH_KEY=$HOME/.ssh/vps_key
FRONT_REMOTE_PATH=/var/www/front
ADMIN_REMOTE_PATH=/var/www/admin

# ── Demo accounts created by seed_upskills_demo.sql (reference only) ──
DEMO_STUDENT_EMAIL=demo@upskillsacademy.com
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=
